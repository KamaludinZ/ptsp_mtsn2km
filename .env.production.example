APP_NAME="PTSP MTsN 2 KOTA MALANG"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com
APP_TIMEZONE=Asia/Jakarta

# Isi "*" bila aplikasi hanya bisa diakses lewat reverse proxy (Docker/Coolify),
# atau daftar IP proxy dipisah koma. Kosongkan bila tanpa proxy.
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database Production - Sesuaikan dengan konfigurasi server
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_secure_password
DB_TIMEOUT=30
DB_PERSISTENT=false
DB_SSLMODE=prefer

# Aset hasil `npm run build` (public/build). Jangan pakai mode vite di produksi.
ASSET_MODE=compiled
CHECK_VITE_SERVER=false

BROADCAST_DRIVER=log
# database: aman untuk beberapa proses PHP; file juga boleh di hosting kecil
CACHE_DRIVER=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Initial admin password used by "php artisan db:seed" (leave empty to
# generate a random one that is printed once)
ADMIN_PASSWORD=

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration - Sesuaikan dengan SMTP server production
MAIL_MAILER=smtp
MAIL_HOST=your_smtp_host
MAIL_PORT=587
MAIL_USERNAME=your_email@domain.com
MAIL_PASSWORD=your_email_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Editor teks (TinyMCE Cloud). Daftarkan domain APP_URL di akun tiny.cloud (Approved Domains).
TINYMCE_API_KEY=

# Versi yang tampil di Monitoring Sistem (diisi otomatis dari berkas RELEASE paket rilis bila kosong)
APP_VERSION=

# Email & WhatsApp diatur di panel (Manajemen Sistem → Integrasi Notifikasi);
# nilai di bawah hanya cadangan sampai pengaturan di panel disimpan.
# WhatsApp API Gateway Settings (opsional)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_SENDER_ID=
