# Variables for `docker compose` on a plain VPS (Coolify has its own
# Environment Variables tab; it fills SERVICE_* itself).
# Copy to .env next to docker-compose.yml and fill in the required ones.

# --- Required -------------------------------------------------------------
# php artisan key:generate --show   (or: echo "base64:$(openssl rand -base64 32)")
APP_KEY=
# Public address, https:// in production
APP_URL=https://ptsp.example.sch.id
# Database account created on the first start of the postgres service
SERVICE_USER_POSTGRES=ptsp
SERVICE_PASSWORD_POSTGRES=
# TinyMCE Cloud key (rich text editor); approve APP_URL's domain at tiny.cloud
TINYMCE_API_KEY=

# --- Optional -------------------------------------------------------------
APP_NAME="PTSP MTsN 2 Kota Malang"
POSTGRES_DB=ptsp
# Password of the first admin (ptsp@mtsn2malang.sch.id); empty = random, printed once in the logs
ADMIN_PASSWORD=
# false only when testing over plain http://
SESSION_SECURE_COOKIE=true
LOG_LEVEL=warning
PHP_FPM_MAX_CHILDREN=10
# docker-compose.ports.yml
APP_BIND=127.0.0.1
APP_PORT=8080
# backup profile
BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
# Shown on Monitoring Sistem (e.g. a release tag)
APP_VERSION=

# Fallbacks until Email/WhatsApp are configured in the panel (Integrasi Notifikasi)
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@mtsn2malang.sch.id
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_SENDER_ID=

# Ganti akun sementara: a session ends by itself after this many minutes
IMPERSONATION_MAX_MINUTES=120
