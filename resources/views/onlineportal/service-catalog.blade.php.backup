        transform: translateY(-8px);
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    }

    /* Stat card pulse animation */
    @keyframes pulse-stat {
        0%, 100% {
            transform: scale(1);
        }
        50% {
            transform: scale(1.05);
        }
