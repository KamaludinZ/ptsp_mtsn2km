# .ngodingpakeaiignore — extra paths to keep out of NgodingPakeAI sync.
# Uses .gitignore syntax. Secrets, node_modules, build output and .env files
# are ALWAYS blocked by the CLI regardless of what is listed here.

# Examples:
# docs/internal/
# *.snap
# fixtures/

# Local agent tooling (not part of the application)
.claude/
.codex/

# Vendor assets published by Filament/plugins (minified build output)
public/js/filament/
public/css/filament/
public/js/awcodes/
public/css/awcodes/

# Lockfiles and placeholder files
composer.lock
package-lock.json
**/.gitignore
