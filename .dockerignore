# Keep the build context small and never ship local secrets or build output
.git
.github
.env
.env.*
!.env.example
!.env.production.example
node_modules
vendor
public/build
public/hot
public/storage
storage/app/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*
bootstrap/cache/*.php
tests
phpunit.xml
.phpunit.result.cache
*.log
docker-compose*.yml
Dockerfile
.dockerignore
.idea
.vscode
