{
    "name": "ptsp/mtsn2-malang",
    "type": "project",
    "description": "PTSP MTsN 2 KOTA MALANG - Sistem Pelayanan Terpadu Satu Pintu - Berjalan tanpa Vite",
    "keywords": [
        "laravel",
        "ptsp",
        "education",
        "egov",
        "no-vite"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "awcodes/filament-tiptap-editor": "^3.5",
        "barryvdh/laravel-dompdf": "^3.0",
        "filament/filament": "^3.2",
        "guzzlehttp/guzzle": "^7.8",
        "laravel/breeze": "^2.0",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.2",
        "laravel/tinker": "^2.9",
        "maatwebsite/excel": "^3.1",
        "spatie/laravel-activitylog": "^4.10",
        "spatie/laravel-medialibrary": "^11.17",
        "spatie/laravel-permission": "^6.9",
        "symfony/html-sanitizer": "^7.4",
        "yajra/laravel-datatables-oracle": "^12.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0",
        "spatie/laravel-ignition": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --provider=\"Spatie\\Permission\\PermissionServiceProvider\""
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-install-cmd": [
            "@php artisan vendor:publish --provider=\"App\\\\Helpers\\\\AssetHelper\" --force"
        ],
        "production:optimize": [
            "php artisan config:cache",
            "php artisan route:cache",
            "php artisan view:cache",
            "php artisan event:cache"
        ],
        "production:deploy": [
            "composer install --optimize-autoloader --no-dev",
            "@composer run production:optimize",
            "php artisan migrate --force"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
